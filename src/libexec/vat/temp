#!/usr/bin/env bash

# Exit immediately if a command exits with a non-zero status
set -e

# Configuration variables from positional arguments
REPO_NAME="$1"
BRANCH_NAME="$2"

# 1. Validation Guard: Check if required arguments are provided
if [[ -z "$REPO_NAME" ]] || [[ -z "$BRANCH_NAME" ]]; then
    echo "❌ Error: Missing arguments."
    echo "Usage: $0 <new-github-repo-name> <new-branch-name>"
    exit 1
fi

# 2. Dependency Guard: Ensure GitHub CLI is installed and available
if ! command -v gh &> /dev/null; then
    echo "❌ Error: GitHub CLI ('gh') is not installed or not in PATH."
    exit 1
fi

# 3. Structural Guard: Ensure this is executed inside an active git workspace
if ! git rev-parse --is-inside-work-tree &> /dev/null; then
    echo "❌ Error: This script must be run inside an initialized Git repository."
    exit 1
fi

# 4. Pre-flight Check: Query the GitHub API to see if the repository exists
echo "🔍 Checking if GitHub repository '$REPO_NAME' already exists..."
if gh repo view "$REPO_NAME" &> /dev/null; then
    echo "⚠️ Alert: Repository '$REPO_NAME' already exists on GitHub."
    echo "🛑 Halting execution to prevent overwriting existing infrastructure."
    exit 1
else
    echo "✅ Confirmed: Repository name is available."
fi

# 5. Core Routine: Refactor remotes and protect the template source
echo "🔄 Renaming original tracking remote to 'upstream'..."
git remote rename origin upstream

echo "🔒 Disabling pushing capabilities to 'upstream'..."
git remote set-url --push upstream DISABLE

# 6. Repository Genesis: Spin up the new infrastructure
echo "🚀 Spawning empty cloud repository '$REPO_NAME' on GitHub..."


# 7. Branch Lifecycle: Isolate development history
CURRENT_BRANCH=$(git branch --show-current)

echo "🌿 Creating and switching to new feature branch '$BRANCH_NAME'..."
git checkout -b "$BRANCH_NAME"

echo "📤 Syncing branch topology to origin..."
git push -u origin "$BRANCH_NAME"

# 8. GitHub Infrastructure Alignment
echo "⏱️ Allowing GitHub indexing to catch up..."
sleep 2

echo "⚙️ Reconfiguring cloud repository default branch to '$BRANCH_NAME'..."
gh repo edit "$REPO_NAME" --default-branch "$BRANCH_NAME"

echo "🎯 Aligning local HEAD tracking pointer with origin..."
git remote set-head origin -a

echo "🎉 Success Workflow complete!"
